{
  "name": "home-jarvis",
  "version": "1.0.0",
  "private": true,
  "description": "A personal Jarvis for Windows: voice desk, lock, and a printed morning paper.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "paper:sample": "node paper/build.mjs paper/sample-edition.json me/papers/sample.pdf"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/old-standard-tt": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "playwright-core": "^1.48.0"
  }
}
